# Copy to ~/.config/undercut/env, fill in the values, then: chmod 600 ~/.config/undercut/env
# The file is sourced by the start scripts (`set -a; . file; set +a`): keep it plain KEY=value,
# quote values that contain special characters.
# CACHE_URL is intentionally unset: production has no Redis and the backend falls back to a
# per-process local-memory cache.

# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
# 127.0.0.1 and localhost let the health checks on the server (curl http://127.0.0.1:8110/...) through.
DJANGO_ALLOWED_HOSTS=undercut.maciejzielinski.dev,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://undercut.maciejzielinski.dev

# Role and database `undercut` (see deploy/termux/README.md). Escape special characters in the password.
DATABASE_URL=postgres://undercut:replace-with-db-password@127.0.0.1:5432/undercut

# Used by the Next.js server to reach the API on loopback.
API_INTERNAL_URL=http://127.0.0.1:8110

# nginx forwards the real client IP in X-Forwarded-For (one proxy hop), so the API throttle
# counts visitors separately instead of treating everyone as 127.0.0.1.
DRF_NUM_PROXIES=1

# Shared secret between the backend worker (which purges cached pages after data changes) and
# the Next.js server (which checks it). Same value for both; generate like DJANGO_SECRET_KEY.
REVALIDATE_SECRET=replace-with-another-long-random-value
REVALIDATE_URL=http://127.0.0.1:3110/_internal/revalidate

# Logging: JSON lines on stdout when DJANGO_DEBUG=false (LOG_FORMAT=text switches to plain text).
# LOG_LEVEL=INFO

# Error reporting (optional). Needs `sentry-sdk` installed by hand in the venv (it is not a project
# dependency, see docs/operations.md); without the package this only logs a warning at start.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# Lets the Next.js server's own API calls skip the anonymous rate limit (all of them come from one
# address, so without it the whole site would share one 60/min bucket). Same value for backend and
# frontend, never sent to browsers.
INTERNAL_API_TOKEN=replace-with-a-third-long-random-value

# E-mail. Leave EMAIL_HOST unset until an SMTP provider is configured: mail (verification and
# password-reset links, race e-mails) is then printed to the service log instead of being sent.
# EMAIL_HOST=smtp-relay.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Undercut <noreply@maciejzielinski.dev>
